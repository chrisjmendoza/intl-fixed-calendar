<?xml version="1.0" encoding="utf-8"?>
<!--
  Every user-visible calendar term and every IFC date pattern (docs/calendar-spec.md §7.3, §7.4, §7.5,
  §7.6; CLAUDE.md rule 9). Patterns are positional so a locale can reorder the fields; they are never
  assembled by concatenation. The twelve Gregorian-named months and the weekday names are NOT here:
  they come from java.time's localized names (§7.6).
-->
<resources>

    <!-- The 7th IFC month, Latin for "sun". A proper noun, conventionally left untranslated; transliterate
         for non-Latin scripts. Full form, used in the long date and headers (§7.6). -->
    <string name="month_sol">Sol</string>
    <!-- Abbreviated form of Sol, used next to abbreviated Gregorian month names ("Sep", "Sol"). Keep it
         about three characters. Never a single letter (§7.6). -->
    <string name="month_sol_short">Sol</string>

    <!-- The intercalary day after June 28 in leap years (Gregorian June 17). Belongs to no month and no
         week (§2.4). -->
    <string name="intercalary_leap_day">Leap Day</string>
    <!-- The intercalary day after December 28, the last day of every year (Gregorian December 31). -->
    <string name="intercalary_year_day">Year Day</string>

    <!-- The marker that distinguishes an IFC date from a Gregorian one wherever the two could be confused
         (share text, widgets, notifications). Keep it short; it precedes numeric dates ("IFC 2026-10-08"). -->
    <string name="ifc_marker">IFC</string>

    <!-- Long date for a regular day, e.g. "September 8, 2026".
         %1$s = full month name, %2$d = day of month (1–28), %3$d = year. Reorder freely for the locale
         (e.g. en-GB: "%2$d %1$s %3$d"). -->
    <string name="date_long_regular">%1$s %2$d, %3$d</string>
    <!-- Long date for an intercalary day, e.g. "Leap Day, 2024" or "Year Day, 2026".
         %1$s = intercalary_leap_day or intercalary_year_day, %2$d = year. -->
    <string name="date_long_intercalary">%1$s, %2$d</string>
    <!-- Medium date for a regular day, e.g. "Sep 8, 2026" or "Sol 8, 2026".
         %1$s = abbreviated month name, %2$d = day of month (1–28), %3$d = year. -->
    <string name="date_medium_regular">%1$s %2$d, %3$d</string>
    <!-- Medium date for an intercalary day, e.g. "Leap Day 2024" or "Year Day 2026".
         %1$s = intercalary_leap_day or intercalary_year_day, %2$d = year. -->
    <string name="date_medium_intercalary">%1$s %2$d</string>

    <!-- The weekday the IFC assigns to a date, labelled so it can never be mistaken for the real one
         (§4.1). %1$s = localized weekday name, e.g. "IFC weekday: Sunday". -->
    <string name="weekday_nominal_labelled">IFC weekday: %1$s</string>
    <!-- Shown in place of the IFC weekday for Leap Day and Year Day, which belong to no week (§4.1 item 5).
         Never blank, never "Sunday". -->
    <string name="weekday_nominal_none">no IFC weekday</string>
    <!-- The real-world weekday of a date, labelled (§4.1). %1$s = localized weekday name,
         e.g. "Actual weekday: Thursday". -->
    <string name="weekday_actual_labelled">Actual weekday: %1$s</string>
    <!-- Spoken (accessibility) form of both weekdays for a regular day (§4.1 item 7).
         %1$s = IFC weekday name, %2$s = actual weekday name, e.g. "IFC Sunday, actual Thursday". -->
    <string name="weekdays_description">IFC %1$s, actual %2$s</string>
    <!-- Spoken (accessibility) form of both weekdays for an intercalary day.
         %1$s = actual weekday name, e.g. "no IFC weekday, actual Thursday". -->
    <string name="weekdays_description_intercalary">no IFC weekday, actual %1$s</string>

    <!-- Day of year and IFC week for a regular day (§7.4). %1$d = day of year (1–366),
         %2$d = IFC week (1–52), %3$d = weeks in the year (always 52). -->
    <string name="day_and_week">Day %1$d · Week %2$d of %3$d</string>
    <!-- Day of year for an intercalary day, which has no week number (§7.4). %1$d = day of year. -->
    <string name="day_outside_weeks">Day %1$d · outside the weeks</string>
    <!-- The 13-week quarter (§7.5). %1$d = quarter number 1–4. -->
    <string name="quarter">Q%1$d</string>

    <!-- How much of the year has elapsed, day of year over the year's length. %1$d = whole percent (0–100);
         "%%" is a literal percent sign. -->
    <string name="year_progress">%1$d%% of the year</string>

    <!-- Countdown to a later date (FEATURES T4). %1$d = number of days (never 0),
         %2$s = the target day's name, e.g. "105 days until Year Day", "1 day until Leap Day". -->
    <plurals name="days_until">
        <item quantity="one">%1$d day until %2$s</item>
        <item quantity="other">%1$d days until %2$s</item>
    </plurals>

    <!-- ===== Month grid (docs/ARCHITECTURE.md §4 "Intercalary days in a 7-column grid",
         "Accessibility"; spec §7.2; FEATURES C1–C4) ===== -->

    <!-- The month grid's heading, e.g. "Sol 2028". %1$s = full month name, %2$d = year. -->
    <string name="month_title">%1$s %2$d</string>
    <!-- A day within its month, without the year, e.g. "Sol 13" (the first part of a cell's spoken
         description). %1$s = full month name, %2$d = day of month (1–28). -->
    <string name="date_month_day">%1$s %2$d</string>

    <!-- Accessibility label of the header row that shows the perpetual IFC weekday names (spec §4.1
         item 3). -->
    <string name="weekday_header_nominal">IFC weekdays</string>
    <!-- Accessibility label of the header row that shows the real weekdays of the month's seven
         columns (spec §4.1 item 3). -->
    <string name="weekday_header_actual">Actual weekdays</string>

    <!-- Spoken description of a regular day cell, first sentence: "Sol 13, IFC Friday."
         %1$s = date_month_day, %2$s = the IFC weekday name. The "IFC" label is mandatory (§4.1 item 7). -->
    <string name="day_description_regular">%1$s, IFC %2$s.</string>
    <!-- Spoken description of an intercalary day, first sentence: "Year Day, no IFC weekday."
         %1$s = intercalary_leap_day or intercalary_year_day, %2$s = weekday_nominal_none. -->
    <string name="day_description_intercalary">%1$s, %2$s.</string>
    <!-- Spoken description, second sentence: the Gregorian date with its real weekday, e.g.
         "Gregorian Tuesday, June 30, 2026." %1$s = the locale's full Gregorian date. -->
    <string name="day_description_gregorian">Gregorian %1$s.</string>
    <!-- Spoken description, optional sentence when the day has events. %1$d = number of events. -->
    <plurals name="day_description_events">
        <item quantity="one">%1$d event.</item>
        <item quantity="other">%1$d events.</item>
    </plurals>
    <!-- Spoken description, optional sentence when the day is a holiday. %1$s = the holiday's name. -->
    <string name="day_description_holiday">Holiday: %1$s.</string>
    <!-- Spoken description, optional last sentence when the day is today; the visual mark is a ring,
         which a screen reader cannot see. -->
    <string name="day_description_today">Today.</string>

    <!-- The intercalary band's second line: the Gregorian date and the "no IFC weekday" note, e.g.
         "Thu, Dec 31, 2026 · no IFC weekday" (spec §7.2). %1$s = Gregorian date with its real
         weekday, %2$s = weekday_nominal_none. -->
    <string name="intercalary_band_subtitle">%1$s · %2$s</string>
    <!-- The Gregorian dates a month covers, shown in the reserved band slot of months that have no
         intercalary day (spec §7.2), e.g. "Jun 18 – Jul 15". %1$s = first day, %2$s = last day. -->
    <string name="gregorian_span">%1$s – %2$s</string>

    <!-- ===== Date pickers (FEATURES D1, D2, E2; spec §7.1, §7.10) ===== -->

    <!-- Label of the year field of the IFC date picker. The IFC year equals the Gregorian year (§2.1). -->
    <string name="picker_year_label">IFC year</string>
    <!-- Supporting text under the year field; turns into the error text while the typed year is not a
         whole year in the range. %1$d = first year (1583), %2$d = last year (9999). -->
    <string name="picker_year_range">Enter a year from %1$d to %2$d</string>
    <!-- Heading above the 13 month options of the IFC date picker (Sol included). -->
    <string name="picker_month_heading">Month</string>
    <!-- Heading above the 28 day options of the IFC date picker. -->
    <string name="picker_day_heading">Day</string>
    <!-- Spoken description of one day option, so a screen reader does not read a bare number.
         %1$d = day of month (1–28). -->
    <string name="picker_day_description">Day %1$d</string>
    <!-- Heading above the Leap Day / Year Day options of the IFC date picker: the two days that belong
         to no month and no week (§2.4). -->
    <string name="picker_intercalary_heading">Days outside the months</string>
    <!-- Shown under the intercalary options when the chosen year is a common year, explaining why Leap
         Day is not offered. %1$s = the year, already formatted (a year is a name, not a quantity, so it
         never needs a plural form). -->
    <string name="picker_leap_day_unavailable">%1$s is not a leap year, so it has no Leap Day.</string>
    <!-- Announced when Leap Day was selected and the year was changed to a common year: the selection
         moves to June 28 (§7.10). %1$s = the new year, already formatted, %2$s = "June 28"
         (date_month_day). -->
    <string name="picker_leap_day_clamped">%1$s has no Leap Day, so the date moved to %2$s.</string>
    <!-- Confirm button of the Gregorian date picker dialog. -->
    <string name="picker_confirm">OK</string>
    <!-- Dismiss button of the Gregorian date picker dialog. -->
    <string name="picker_cancel">Cancel</string>

</resources>
