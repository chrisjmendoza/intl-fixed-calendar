    <string name="events_editor_notification_permission_notice">Reminders are saved, but notifications are off.</string>
    <string name="events_editor_notification_permission_settings">Notification settings</string>
    <string name="events_editor_notification_permission_dismiss">Dismiss</string>

    <string name="events_editor_pick_calendar_title">Pick the date in</string>
    <string name="events_editor_pick_gregorian">Gregorian calendar</string>
    <string name="events_editor_pick_ifc">International Fixed Calendar</string>
    <string name="events_editor_pick_time_title">Choose time</string>

</resources>
