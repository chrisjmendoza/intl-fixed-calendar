root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# Compose functions are PascalCase by convention; this is ktlint's documented opt-out for them.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml,toml,json}]
indent_size = 2

[*.bat]
end_of_line = crlf
