<?xml version="1.0" encoding="utf-8"?>
<!--
  Month-grid widget provider info for API 31 and later. Replaces (not merges with)
  res/xml/month_widget_info.xml wholesale on API 31+, adding four attributes introduced in that API
  level: maxResizeWidth/Height (upper resize bound; below API 31 the OS lets a widget resize without an
  upper bound once minResizeWidth/Height are met), targetCellWidth/Height (the launcher's preferred
  initial cell size, about 4x3, matching MonthGlanceWidget.COMPACT) and previewLayout (the
  widget-picker preview; reuses the loading layout since dedicated preview art is ROADMAP M5 T5). Keep
  every other attribute identical to the base file.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="180dp"
    android:maxResizeWidth="320dp"
    android:maxResizeHeight="320dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="14400000"
    android:initialLayout="@layout/month_widget_loading"
    android:previewLayout="@layout/month_widget_loading"
    android:description="@string/month_widget_description" />
